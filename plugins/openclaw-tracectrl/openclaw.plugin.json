{
  "id": "tracectrl",
  "name": "TraceCtrl",
  "description": "Security observability — rich traces, tool monitoring, and risk detection for AI agents",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "endpoint": {
        "type": "string",
        "description": "OTLP collector endpoint"
      },
      "serviceName": {
        "type": "string",
        "description": "Service name for traces"
      },
      "captureContent": {
        "type": "boolean",
        "description": "Capture message and tool content (privacy-sensitive)"
      },
      "protocol": {
        "type": "string",
        "enum": ["http", "grpc"],
        "description": "OTLP export protocol"
      },
      "traces": {
        "type": "boolean",
        "description": "Enable trace export"
      },
      "metrics": {
        "type": "boolean",
        "description": "Enable metrics export"
      },
      "metricsIntervalMs": {
        "type": "number",
        "description": "Metrics export interval in milliseconds"
      },
      "headers": {
        "type": "object",
        "description": "Custom headers for OTLP exporter",
        "additionalProperties": { "type": "string" }
      }
    },
    "additionalProperties": false
  },
  "uiHints": {
    "endpoint": { "label": "Collector Endpoint", "placeholder": "http://localhost:4318" },
    "serviceName": { "label": "Service Name", "placeholder": "openclaw-gateway" },
    "captureContent": { "label": "Capture Content", "help": "Enable to capture message text and tool inputs/outputs" }
  }
}
